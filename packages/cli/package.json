{
	"name": "@involvex/term",
	"version": "0.1.0",
	"description": "CLI for Involvex-Term: install/upgrade the latest release and control the running window (sp, nt)",
	"keywords": [
		"involvex-term",
		"terminal",
		"cli",
		"electron",
		"windows-terminal",
		"git",
		"xterm",
		"pty",
		"wt",
		"installer"
	],
	"homepage": "https://github.com/involvex/involvex-term#readme",
	"bugs": {
		"url": "https://github.com/involvex/involvex-term/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/involvex-term.git",
		"directory": "packages/cli"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/involvex"
	},
	"license": "MIT",
	"author": "involvex",
	"type": "module",
	"bin": {
		"involvex-term": "dist/cli.js",
		"involvex-term-dev": "src/cli.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun build src/cli.ts --target node --outfile dist/cli.js",
		"dev": "bun run src/cli.ts",
		"prepublishOnly": "bun run build"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	}
}
