# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-electron
dist-ssr
release
build
# Store APPX logos (electron-builder buildResources); keep under resources/
# so they are not wiped by the `build` ignore above.
coverage
*.tsbuildinfo
*.local
store-identity.env
# Keep the example tracked despite the `*.env` rule above.
!store-identity.example.env

# Native Explorer-command build outputs (keep out/.gitkeep)
native/explorer-command/out/**
!native/explorer-command/out/.gitkeep

# Machine-specific npm config (PYTHON path for node-gyp), see README
.npmrc

