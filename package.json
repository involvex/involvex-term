{
	"name": "involvex-term",
	"version": "0.5.0",
	"private": true,
	"description": "Minimalist dark Git-aware terminal (Electron + xterm.js + node-pty)",
	"homepage": "https://github.com/involvex/involvex-term#readme",
	"bugs": {
		"url": "https://github.com/involvex/involvex-term/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/involvex-term.git"
	},
	"license": "MIT",
	"author": "involvex",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"prebuild": "bun run format && bun run lint --fix && bun run typecheck",
		"build": "tsc && vite build && bun scripts/rebuild-pty.mjs && electron-builder && bun scripts/link-latest.mjs",
		"build:electron": "tsc --project tsconfig.node.json && vite build",
		"dev": "vite",
		"dev:electron": "vite",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"postinstall": "bun scripts/patch-node-pty.mjs",
		"link:desktop": "bun scripts/link-latest.mjs --desktop",
		"link:latest": "bun scripts/link-latest.mjs",
		"lint": "eslint . --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"rebuild": "bun scripts/rebuild-pty.mjs --force",
		"typecheck": "tsc --noEmit"
	},
	"prettier": "@involvex/prettier-config",
	"dependencies": {
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-search": "^0.16.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"chokidar": "^5.0.0",
		"electron-updater": "^6.8.9",
		"node-pty": "^1.1.0",
		"react": "^19",
		"react-dom": "^19",
		"simple-git": "^4",
		"systeminformation": "^5.27.9",
		"zod": "^4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@involvex/prettier-config": "^0.0.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"electron": "^44",
		"electron-builder": "^26",
		"electron-rebuild": "^3.2.9",
		"eslint": "^10",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"typescript": "^5",
		"typescript-eslint": "^8.70.1",
		"vite": "^8",
		"vite-plugin-electron": "^1",
		"vite-plugin-electron-renderer": "^1"
	}
}
