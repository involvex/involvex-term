// @see - https://www.electron.build/configuration/configuration
{
	$schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
	appId: 'dev.involvex.term',
	asar: true,
	npmRebuild: false,
	productName: 'involvex-term',
	directories: {
		output: 'release/${version}',
	},
	files: ['dist', 'dist-electron'],
	// Sparse Explorer-command artifacts (built by scripts/build-explorer-command.mjs).
	// Empty out/ (Linux / no MSVC) simply adds nothing.
	extraFiles: [
		{
			from: 'native/explorer-command/out',
			to: '.',
			filter: [
				'InvolvexTermExplorerCommand.dll',
				'InvolvexTermExplorerCommand.msix',
			],
		},
	],
	mac: {
		target: ['dmg'],
		artifactName: '${productName}-Mac-${version}-Installer.${ext}',
	},
	win: {
		icon: 'public/icon.ico',
		target: [
			{
				target: 'nsis',
				arch: ['x64'],
			},
			{
				target: 'portable',
				arch: ['x64'],
			},
		],
	},
	nsis: {
		oneClick: false,
		perMachine: false,
		allowToChangeInstallationDirectory: true,
		deleteAppDataOnUninstall: false,
		artifactName: '${productName}-Windows-${version}-Setup.${ext}',
		include: 'scripts/installer.nsh',
	},
	portable: {
		artifactName: '${productName}-Windows-${version}-Portable.${ext}',
	},
	linux: {
		icon: 'public/icon.png',
		category: 'TerminalEmulator',
		syncDesktopName: true,
		target: ['AppImage'],
		artifactName: '${productName}-Linux-${version}.${ext}',
	},

	publish: [
		{
			provider: 'github',
			owner: 'involvex',
			repo: 'involvex-term',
		},
	],
}
