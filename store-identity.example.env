# Copy to store-identity.env (gitignored) and fill from Partner Center → Product identity.
# After reserving "Involvex Term" (MSIX or PWA app), Package/Identity/Name is usually
# <PublisherPrefix>.InvolvexTerm (same prefix as your other apps).

STORE_IDENTITY_NAME=Einzelunternehmen.InvolvexTerm
STORE_PUBLISHER=CN=50777D18-6AA9-43B0-9CE5-BB776BC9514F
STORE_PUBLISHER_DISPLAY_NAME=involvex
# Store ID / ProductId (Involvex Term):
STORE_PRODUCT_ID=9NBNBH9CJ507
# Live listing: https://apps.microsoft.com/detail/9NBNBH9CJ507
# Share: https://apps.microsoft.com/store/detail/9NBNBH9CJ507?cid=DevShareMCLPCS
