# Copy to store-identity.env (gitignored) and fill from Partner Center → Product identity.
# Do not commit real publisher CN values if your team treats them as sensitive.

STORE_IDENTITY_NAME=YourPublisherPrefix.InvolvexTerm
STORE_PUBLISHER=CN=00000000-0000-0000-0000-000000000000
STORE_PUBLISHER_DISPLAY_NAME=involvex
# Optional until the listing is live (12-char Store product id):
# STORE_PRODUCT_ID=9NXXXXXXXXXX
